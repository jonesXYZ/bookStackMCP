# BookStack instance URL; either https://bookstack.example.com or its /api URL.
BOOKSTACK_API_URL=https://bookstack.example.com

# BookStack API token ID and secret. Use a dedicated account with only the permissions you need.
BOOKSTACK_API_TOKEN=
BOOKSTACK_API_KEY=

# Read access is always available. Each mutation category requires an explicit opt-in.
BOOKSTACK_ENABLE_WRITE=false
BOOKSTACK_ENABLE_DELETE=false
BOOKSTACK_ENABLE_ADMIN=false
BOOKSTACK_ENABLE_IMPORTS=false
